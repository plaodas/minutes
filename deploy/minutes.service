[Unit]
Description=Minutes Portfolio MVP (Docker Compose)
After=network.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/agake/minutes
ExecStart=/usr/bin/docker compose -f /home/agake/minutes/docker-compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f /home/agake/minutes/docker-compose.yml down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

# Note: Replace '/home/agake/minutes' with the actual project path on the VPS if different.
