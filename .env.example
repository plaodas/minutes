# Docker Compose reads this file for ${VAR} interpolation in docker-compose.yml.
# It does not inject the whole file into containers (no env_file:).
# Keys that are not referenced by docker-compose.yml are ignored.

POSTGRES_USER=minutes
POSTGRES_PASSWORD=minutes_password
POSTGRES_DB=minutes

# Local portfolio login. Change these outside a local demo environment.
ADMIN_USER=demo
ADMIN_PASS=demo
JWT_SECRET=portfolio-dev-secret-change-me

# Extra browser port. Port 80 is always published so http://localhost works.
# Do not set this to 80; that would duplicate the 80:80 mapping.
FRONTEND_PORT=8080

# CPU transcription. The model downloads on the first task.
TRANSCRIBE_MODEL_SIZE=small

# Used only with: docker compose --profile llm up --build -d
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODELS=
OLLAMA_TIMEOUT=120

# Local Python commands only. Compose builds DATABASE_URL from POSTGRES_*.
# DATABASE_URL=postgresql://minutes:minutes_password@localhost:5432/minutes
